// TaskFlow — Prisma Schema for MongoDB
// Personal task/goal manager with social collaboration (friends, sharing, chat).
// Run `npx prisma db push` to sync, then `npx prisma generate`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ============================================================
// USER
// ============================================================
enum SystemRole {
  ADMIN
  MEMBER
}

model User {
  id         String     @id @default(auto()) @map("_id") @db.ObjectId
  publicId   String     @unique // 6-char friend code, e.g. "K7M2QX"
  username   String?    // optional @handle (uniqueness enforced in app — Mongo can't unique-index a nullable field with many nulls)
  name       String
  email      String     @unique
  password   String
  avatar     String?
  bio        String?
  role       SystemRole @default(MEMBER)
  lastSeenAt DateTime   @default(now()) // presence
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  // Social
  sentRequests     Friendship[] @relation("Requester")
  receivedRequests Friendship[] @relation("Addressee")

  // Work
  ownedProjects Project[]       @relation("ProjectOwner")
  memberships   ProjectMember[]
  createdTasks  Task[]          @relation("TaskCreator")
  assignedTasks Task[]          @relation("TaskAssignee")
  goals         Goal[]
  comments      Comment[]

  // Chat
  conversations ConversationParticipant[]
  messages      Message[]

  // Signals
  notifications  Notification[] @relation("NotifRecipient")
  actedNotifs    Notification[] @relation("NotifActor")
  activities     Activity[]
  timeLogs       TimeLog[]

  @@index([name])
  @@index([username])
}

// ============================================================
// FRIENDSHIP
// ============================================================
enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

model Friendship {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  requesterId String           @db.ObjectId
  addresseeId String           @db.ObjectId
  status      FriendshipStatus @default(PENDING)
  pairKey     String           @unique // sorted "minId_maxId" — one row per pair, any direction
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  requester User @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("Addressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@index([requesterId])
  @@index([addresseeId])
  @@index([status])
}

// ============================================================
// PROJECT + MEMBERSHIP
// ============================================================
enum ProjectRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

model Project {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  color       String   @default("#5e6ad2")
  icon        String   @default("folder")
  isPersonal  Boolean  @default(false) // auto-created "Personal" space
  ownerId     String   @db.ObjectId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner      User            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members    ProjectMember[]
  sections   Section[]
  tasks      Task[]
  goals      Goal[]
  activities Activity[]
  milestones Milestone[]
  tags       Tag[]

  @@index([ownerId])
}

model ProjectMember {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  projectId String      @db.ObjectId
  userId    String      @db.ObjectId
  role      ProjectRole @default(EDITOR)
  joinedAt  DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

// ============================================================
// SECTION (board columns)
// ============================================================
model Section {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  position  Int
  projectId String @db.ObjectId

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId])
}

// ============================================================
// TASK
// ============================================================
enum Priority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  description  String?
  priority     Priority  @default(NONE)
  position     Int       @default(0)
  dueDate      DateTime?
  startDate    DateTime?
  completedAt  DateTime? // null = open
  isFavorite   Boolean   @default(false)
  tags         String[] // legacy freeform labels
  watcherIds   String[]  @db.ObjectId // notified without being assignee
  deletedAt    DateTime? // soft delete

  // PMS fields
  taskType        String?
  estimateMinutes Int?
  billable        Boolean   @default(false)
  plannedStart    DateTime?
  plannedEnd      DateTime?
  tagIds          String[]  @db.ObjectId // managed Tag refs
  followerIds     String[]  @db.ObjectId

  // Foreign keys
  projectId    String  @db.ObjectId
  sectionId    String  @db.ObjectId
  assigneeId   String? @db.ObjectId
  creatorId    String  @db.ObjectId
  parentTaskId String? @db.ObjectId
  goalId       String? @db.ObjectId
  milestoneId  String? @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  section    Section    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  assignee   User?      @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator    User       @relation("TaskCreator", fields: [creatorId], references: [id])
  parentTask Task?      @relation("SubTasks", fields: [parentTaskId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subtasks   Task[]     @relation("SubTasks")
  goal       Goal?      @relation(fields: [goalId], references: [id], onDelete: SetNull)
  milestone  Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  comments   Comment[]
  activities Activity[]
  timeLogs   TimeLog[]

  @@index([projectId])
  @@index([sectionId])
  @@index([assigneeId])
  @@index([goalId])
  @@index([milestoneId])
  @@index([parentTaskId])
}

// ============================================================
// MILESTONE
// ============================================================
model Milestone {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  color     String    @default("#5b5fc7")
  dueDate   DateTime?
  completed Boolean   @default(false)
  projectId String    @db.ObjectId
  createdAt DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId])
}

// ============================================================
// TAG (managed, colored, per project)
// ============================================================
model Tag {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  color     String @default("#5b5fc7")
  projectId String @db.ObjectId

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// ============================================================
// TIME LOG (work logs / timesheets)
// ============================================================
model TimeLog {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  taskId          String    @db.ObjectId
  userId          String    @db.ObjectId
  startedAt       DateTime
  endedAt         DateTime?
  durationSeconds Int       @default(0)
  note            String?
  createdAt       DateTime  @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([taskId])
  @@index([userId])
}

// ============================================================
// GOAL
// ============================================================
enum GoalStatus {
  ACTIVE
  ON_HOLD
  ACHIEVED
  ARCHIVED
}

model Goal {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  status      GoalStatus @default(ACTIVE)
  targetDate  DateTime?
  progress    Int        @default(0) // 0–100, rolled up from linked tasks
  ownerId     String     @db.ObjectId
  projectId   String?    @db.ObjectId
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  owner   User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  tasks   Task[]

  @@index([ownerId])
  @@index([projectId])
}

// ============================================================
// COMMENT
// ============================================================
model Comment {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  content    String
  mentionIds String[] @db.ObjectId
  taskId     String   @db.ObjectId
  authorId   String   @db.ObjectId
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([taskId])
}

// ============================================================
// CHAT
// ============================================================
model Conversation {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  isGroup         Boolean  @default(false)
  name            String? // groups only
  avatar          String? // group icon URL
  pairKey         String?  @unique // DMs: sorted "minId_maxId"
  pinnedMessageId String?  @db.ObjectId // single pinned message
  disappearSeconds Int? // null = off; messages vanish after N seconds
  lastMessageAt   DateTime @default(now())
  createdAt       DateTime @default(now())

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String    @db.ObjectId
  userId         String    @db.ObjectId
  lastReadAt     DateTime? // drives unread counts
  muted          Boolean   @default(false)
  favorite       Boolean   @default(false)
  clearedAt      DateTime? // hide messages before this point (clear/delete history)
  joinedAt       DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String    @db.ObjectId
  senderId       String    @db.ObjectId
  content        String
  attachments    String[] // image URLs
  reactions      Json? // { "👍": ["userId", ...], ... }
  replyToId      String?   @db.ObjectId
  expiresAt      DateTime? // disappearing messages
  createdAt      DateTime  @default(now())
  editedAt       DateTime?
  deletedAt      DateTime? // soft delete

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id])
  replyTo      Message?     @relation("MessageReply", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies      Message[]    @relation("MessageReply")

  @@index([conversationId])
}

// ============================================================
// NOTIFICATION
// ============================================================
enum NotificationType {
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  PROJECT_INVITE
  TASK_ASSIGNED
  TASK_COMMENT
  TASK_MENTION
  TASK_DUE
  NEW_MESSAGE
}

model Notification {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  recipientId String           @db.ObjectId
  actorId     String?          @db.ObjectId
  type        NotificationType
  title       String
  body        String?
  entityType  String? // "FRIENDSHIP" | "PROJECT" | "TASK" | "CONVERSATION"
  entityId    String? // makes the notification actionable (Accept/Decline)
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  recipient User  @relation("NotifRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User? @relation("NotifActor", fields: [actorId], references: [id])

  @@index([recipientId, isRead])
}

// ============================================================
// ACTIVITY (audit trail)
// ============================================================
model Activity {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  action    String // CREATED, MOVED, COMPLETED, ASSIGNED, ...
  details   String? // JSON
  taskId    String?  @db.ObjectId
  projectId String?  @db.ObjectId
  userId    String   @db.ObjectId
  createdAt DateTime @default(now())

  task    Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id])

  @@index([projectId])
  @@index([taskId])
}
